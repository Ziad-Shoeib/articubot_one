<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >


    <!-- Attach the camera to the base_link -->
    <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.1 0 0.2" rpy="0 0 0"/>
    </joint>


    <!-- Depth Camera Link -->
    <link name="depth_camera_link">
    <visual>
        <geometry>
        <box size="0.05 0.05 0.05"/>
        </geometry>
        <material>
        <color rgba="0 0 1 1"/>
        </material>
    </visual>
    </link>


    <!-- Gazebo Plugin for Depth Camera -->
    <gazebo reference="depth_camera_link">
        <sensor name="d435_depth" type="depth_camera">
            <always_on>1</always_on>
            <update_rate>30.0</update_rate> <!-- Change to 90 if RViz can handle it -->
            <visualize>false</visualize>
            <topic>/depth_camera/image_raw</topic>
            <pose>0 0 0 0 0 0</pose>

            <camera name="d435">
            <horizontal_fov>1.48702</horizontal_fov>
            <image>
                <width>1280</width>
                <height>720</height>
                <format>B8G8R8</format>
            </image>
            <clip>
                <near>0.1</near>
                <far>100.0</far>
            </clip>
            <noise>
                <type>gaussian</type>
                <mean>0</mean>
                <stddev>0.1</stddev>
            </noise>
            </camera>

            <!-- Gazebo ROS 2 Bridge Plugin -->
            <!-- <plugin name="gz_ros_depth_camera_controller" filename="gz-sim-depth-camera-system"> -->
            <!-- <ros>
                <remapping>image_raw:=/depth_camera/image_raw</remapping>
                <remapping>camera_info:=/depth_camera/camera_info</remapping>
            </ros> -->
            <!-- </plugin> -->
        </sensor>
    </gazebo>



</robot>